{
  "manifestVersion": 5,
  "id": "jp.yone.voxpanel.premiere",
  "name": "VOX Panel",
  "version": "1.2.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": "all" }
  },
  "entrypoints": [{
    "type": "panel",
    "id": "voxPanel",
    "label": { "default": "VOX Panel" },
    "minimumSize": { "width": 280, "height": 500 },
    "preferredDockedSize": { "width": 340, "height": 720 },
    "preferredFloatingSize": { "width": 380, "height": 760 }
  }]
}
